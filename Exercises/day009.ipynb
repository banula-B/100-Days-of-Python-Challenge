   "source": [
    "### Exercise No: 01\n",
    "\n",
    "This is a program to find if a number between **1 and 100** (inclusive)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "abcbef5d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The number is between 1 and 100.\n"
     ]
    }
   ],
   "source": [
    "a = int(input(\"Enter your number\"))\n",
    "\n",
    "if a >= 0 and a <=100:\n",
    "    print(\"The number is between 1 and 100.\")\n",
    "else:\n",
    "    print(\"The number is not-inclusive\")"
   ]
  },
